# ── Helius ──────────────────────────────────────────────────────────────────
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
HELIUS_WEBHOOK_SECRET=              # HMAC secret used to verify incoming webhook payloads

# ── Solana ───────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Market APIs ──────────────────────────────────────────────────────────────
BIRDEYE_API_KEY=
# DexScreener and GeckoTerminal and Jupiter are keyless on free tier — no key needed

# ── Pump.fun context ─────────────────────────────────────────────────────────
BITQUERY_API_KEY=                   # optional; Pump.fun context when quota allows

# ── Social APIs ──────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=wigs/0.1 by /u/youruser

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=            # Chat ID to send STRONG_WATCH / STRONG_CANDIDATE alerts

DISCORD_ALERT_WEBHOOK_URL=         # Discord webhook URL for alerts
SLACK_ALERT_WEBHOOK_URL=           # Slack incoming webhook URL for alerts

YOUTUBE_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://wigs:wigs@localhost:5432/wigs

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Scoring thresholds ────────────────────────────────────────────────────────
MIN_LIQUIDITY_USD=5000              # Hard veto: token liquidity below this → REJECTED
MAX_PRICE_IMPACT_1_SOL=0.15        # Hard veto: 1 SOL sell impact above this → REJECTED
MAX_PRICE_IMPACT_5_SOL=0.40        # Hard veto: 5 SOL sell impact above this → REJECTED
MAX_GINI_COEFFICIENT=0.90          # Hard veto: holder concentration above this → REJECTED
MAX_HHI=0.25                       # Hard veto: HHI above this (+ other flags) → REJECTED
MAX_TOP_10_HOLDER_PCT=0.60         # Hard veto: top 10 holders > 60% → REJECTED

SCORE_WATCH_THRESHOLD=45
SCORE_STRONG_WATCH_THRESHOLD=60
SCORE_STRONG_CANDIDATE_THRESHOLD=75

# ── Convergence settings ──────────────────────────────────────────────────────
CONVERGENCE_RECENCY_LAMBDA=0.05    # Exponential decay rate for recency weighting
CONVERGENCE_FORCED_UPGRADE_MIN_WALLETS=3
CONVERGENCE_FORCED_UPGRADE_MAX_SPREAD_SECONDS=600

# ── Wallet scoring ────────────────────────────────────────────────────────────
WALLET_FRESHNESS_LAMBDA=0.1        # Decay rate for freshness score
WALLET_ACTIVE_QUALITY_THRESHOLD=50
WALLET_DEGRADED_QUALITY_THRESHOLD=25

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_TELEGRAM_ALERTS=true
ENABLE_DISCORD_ALERTS=true
ENABLE_SLACK_ALERTS=false
SLACK_MIN_CONVERGENCE_WALLETS=2
ENABLE_SOCIAL_SCORING=true         # Disable to skip social APIs in early testing
ENABLE_GDELT=true
ENABLE_YOUTUBE=true
